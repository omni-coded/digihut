# Copy this file to .env and fill in your real values.
# Never commit .env to Git.

# WhatsApp number with country code, digits only (example format: 91XXXXXXXXXX).
# Every "WhatsApp" button on the site opens a chat with this number.
VITE_WHATSAPP_NUMBER=919755307900

# Shown in the Contact section.
VITE_CONTACT_EMAIL=digihutsupport@gmail.com
# Optional calling number. Leave empty to show WhatsApp only.
VITE_CONTACT_PHONE=

# Instagram handle without the @
VITE_INSTAGRAM_HANDLE=digihut_cg

# Supabase (stores enquiries and powers the /#/admin page).
# Find these in Supabase → Project Settings → API.
# The anon key is safe to expose in the browser ONLY because Row Level Security
# is enabled by supabase/schema.sql. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spam check: Cloudflare Turnstile site key (free at dash.cloudflare.com → Turnstile).
# Leave empty until the submit-lead function is deployed (see README → Spam protection).
VITE_TURNSTILE_SITE_KEY=

# Your live website address, used for sharing links (example: https://digihut.in)
VITE_SITE_URL=

# Set to true to hide the small "setup needed" reminder once you are live
# without Supabase (WhatsApp-only enquiries).
VITE_HIDE_SETUP_NOTICE=false
